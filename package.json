  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.0.0",
    "electron": "^26.0.0",
    "vite": "^5.0.0",
    "concurrently": "^8.0.0",
    "wait-on": "^7.0.0",
    "electron-builder": "^24.0.0"
  }
}
