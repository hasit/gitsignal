{
  "name": "gitsignal",
  "author": {
    "name": "Hasit Mistry",
    "email": "hasitnm@gmail.com"
  },
  "description": "Manage GitHub notifications on your desktop.",
  "version": "0.1.0",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "start": "NODE_ENV=development electron .",
    "dev:electron": "concurrently \"vite\" \"wait-on http://localhost:5173 && NODE_ENV=development electron .\"",
    "build:web": "vite build",
    "build:electron": "npm run build:web && electron-builder --mac",
    "build": "vite build && electron-builder",
    "package": "electron-builder --mac"
  },
  "dependencies": {
    "axios": "^1.4.0",
    "electron-store": "^8.1.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "optionalDependencies": {
    "keytar": "^7.9.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.0.0",
    "electron": "^26.0.0",
    "vite": "^5.0.0",
    "concurrently": "^8.0.0",
    "wait-on": "^7.0.0",
    "electron-builder": "^24.0.0"
  }
}
