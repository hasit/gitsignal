{
  "name": "gitsignal",
  "productName": "GitSignal",
  "author": {
    "name": "Hasit Mistry",
    "email": "hasitnm@gmail.com"
  },
  "description": "View and manage GitHub notifications on your desktop.",
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "private": true,
  "main": "electron/main.js",
  "build": {
    "appId": "dev.gitsignal",
    "productName": "GitSignal",
    "mac": {
      "icon": "electron/assets/icon.icns"
    }
  },
  "scripts": {
    "dev": "vite",
    "start": "NODE_ENV=development electron .",
    "dev:electron": "concurrently \"vite\" \"wait-on http://localhost:5173 && NODE_ENV=development electron .\"",
    "build:web": "vite build",
    "build:electron": "npm run build:web && electron-builder --mac",
    "build": "vite build && electron-builder",
    "package": "electron-builder --mac"
  },
  "dependencies": {
    "axios": "1.13.2",
    "electron-store": "11.0.2",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "optionalDependencies": {
    "keytar": "7.9.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "5.1.2",
    "concurrently": "9.2.1",
    "electron": "39.2.7",
    "electron-builder": "26.0.12",
    "vite": "7.3.0",
    "wait-on": "9.0.3"
  }
}
